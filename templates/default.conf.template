        listen       ${HTTPS_PORT} ssl;
        listen       [::]:${HTTPS_PORT} ssl;
        server_name  ${SERVER_NAME};
        root         /usr/share/nginx/html;
	underscores_in_headers on;

        ssl_certificate "/etc/nginx/certs/server.crt";
        ssl_certificate_key "/etc/nginx/private/server.key";
        ssl_session_cache shared:SSL:1m;
        ssl_session_timeout  10m;
        ssl_ciphers HIGH:!aNULL:!MD5;
        ssl_prefer_server_ciphers on;
        ssl_password_file "/etc/nginx/private/passwords.txt";
        ssl_client_certificate "/etc/nginx/certs/tls-ca-bundle.pem";
#	ssl_verify_client optional;
	ssl_verify_client on;

        error_page 404 /404.html;
            location = /40x.html {
        }

        error_page 500 502 503 504 /50x.html;
            location = /50x.html {
        }
        location /api/ {
                proxy_pass ${LOGVIEWER_REST_SERVICE};
		proxy_set_header CORTANA_DN $ssl_client_s_dn;
        }
        location /test {
		add_header Content-Type text/plain;
		return 200 "user name: $ssl_client_s_dn $ssl_client_s_dn_legacy";
        }

    }

